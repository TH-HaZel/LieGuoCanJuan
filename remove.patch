diff --git a/public/style.css b/public/style.css
--- a/public/style.css
+++ b/public/style.css
@@ -0,0 +1,9 @@
+/* 缩小标题栏，并固定三人局两位对手的位置。 */
+html body header{height:44px}
+#game#game>.room-info{height:44px}
+@media (min-width:901px){
+  #game#game#game#game #opponents:has(>.opponent:nth-child(2)):not(:has(>.opponent:nth-child(3))){
+    position:fixed;top:54px;left:16px;right:305px;margin:0;padding:0;
+  }
+  #game#game#game#game #opponents:has(>.opponent:nth-child(2)):not(:has(>.opponent:nth-child(3)))>.opponent{transform:none}
+}
